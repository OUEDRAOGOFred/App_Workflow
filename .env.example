# Local development only. Internal databases are not published to the host.
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow_local_dev
POSTGRES_DB=workflow_auth
AGENT_DB_PASSWORD=agents_local_dev
WORKFLOW_DB_PASSWORD=workflows_local_dev
INTEGRATION_DB_PASSWORD=integrations_local_dev
EXECUTION_DB_PASSWORD=executions_local_dev
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Africa/Ouagadougou
EXECUTION_MAX_SECONDS=7200
GATEWAY_PORT=8000
FRONTEND_PORT=8080
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Empty: generated once into the Docker secrets volume, shared by API services.
# To override: generate >=32 random characters. Never commit your .env.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
# Empty FERNET_KEY: generated once in the persistent secrets volume.
FERNET_KEY=
MOCK_INTEGRATIONS=true
POLLING_ENABLED=true
GMAIL_POLL_SECONDS=30
TELEGRAM_POLL_SECONDS=1
# Private HTTP hosts are blocked unless explicitly listed here (comma separated).
HTTP_ALLOWED_HOSTS=
TELEGRAM_TOKEN=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=phi3
CLASSIFIER_BACKEND=auto
OLLAMA_TIMEOUT=30
OLLAMA_RETRIES=2
CLASSES=facture,contrat,cv
# Optional JSON training corpus for the demo adapter. Mount its file into /srv.
MODEL_PATH=
OCR_ENABLED=false
INSTALL_OCR=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/oauth/callback
GOOGLE_TEST_USER_EMAIL=
GMAIL_APP_PASSWORD=

